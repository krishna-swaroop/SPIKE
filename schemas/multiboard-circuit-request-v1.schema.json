{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/multiboard-circuit-request/v1",
  "title": "Explicit coupled multiboard reduced circuit request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "assembly",
    "domain",
    "board_models",
    "link_models",
    "ground",
    "analysis"
  ],
  "properties": {
    "contract": {
      "const": "spike/multiboard-circuit-request/v1"
    },
    "domain": {
      "enum": [
        "pi",
        "si"
      ]
    },
    "assembly": {
      "type": "object",
      "required": [
        "contract",
        "assembly_id",
        "name",
        "boards"
      ],
      "properties": {
        "contract": {
          "const": "spike/assembly-ir/v1"
        }
      }
    },
    "board_models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "board_id",
          "elements"
        ],
        "properties": {
          "board_id": {
            "type": "string",
            "minLength": 1
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "positive_node",
                "negative_node"
              ]
            }
          }
        }
      }
    },
    "link_models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "kind",
          "pins"
        ],
        "properties": {
          "link_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "harness",
              "mate"
            ]
          },
          "pins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "$ref": "#/$defs/pin"
            }
          }
        }
      }
    },
    "ground": {
      "$ref": "#/$defs/reference"
    },
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "operating_point"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "start_hz",
            "stop_hz",
            "points"
          ],
          "properties": {
            "mode": {
              "const": "ac"
            },
            "start_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stop_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "scale": {
              "enum": [
                "log",
                "linear"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_id",
        "node"
      ],
      "properties": {
        "board_id": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pin",
        "target_pin",
        "resistance_ohm",
        "inductance_h"
      ],
      "properties": {
        "source_pin": {
          "type": "string",
          "minLength": 1
        },
        "target_pin": {
          "type": "string",
          "minLength": 1
        },
        "resistance_ohm": {
          "$ref": "#/$defs/nonnegative"
        },
        "inductance_h": {
          "$ref": "#/$defs/nonnegative"
        },
        "capacitance_f": {
          "$ref": "#/$defs/nonnegative"
        },
        "contact_a_resistance_ohm": {
          "$ref": "#/$defs/nonnegative"
        },
        "contact_b_resistance_ohm": {
          "$ref": "#/$defs/nonnegative"
        },
        "contact_a_inductance_h": {
          "$ref": "#/$defs/nonnegative"
        },
        "contact_b_inductance_h": {
          "$ref": "#/$defs/nonnegative"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "capacitance_f"
            ],
            "properties": {
              "capacitance_f": {
                "exclusiveMinimum": 0
              }
            }
          },
          "then": {
            "required": [
              "reference"
            ]
          }
        }
      ]
    }
  }
}
