{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/multiboard-thermal-request-v1.schema.json",
  "title": "SPIKE explicit coupled multiboard thermal RC request",
  "type": "object",
  "required": [
    "contract",
    "assembly",
    "board_models",
    "contact_models"
  ],
  "properties": {
    "contract": {
      "const": "spike/multiboard-thermal-request/v1"
    },
    "assembly": {
      "$ref": "assembly-ir-v1.schema.json"
    },
    "mode": {
      "enum": [
        "steady_state",
        "transient"
      ]
    },
    "ambient_temperature_c": {
      "type": "number",
      "minimum": -273.15
    },
    "time_step_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "board_models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "board_id",
          "elements"
        ],
        "properties": {
          "board_id": {
            "$ref": "#/$defs/id"
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/element"
            }
          },
          "links": {
            "type": "array",
            "maxItems": 8192,
            "items": {
              "$ref": "#/$defs/link"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "contact_models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "contact_id",
          "from",
          "to",
          "conductance_w_per_k"
        ],
        "properties": {
          "contact_id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/endpoint"
          },
          "to": {
            "$ref": "#/$defs/endpoint"
          },
          "conductance_w_per_k": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "transient"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "time_step_s",
          "duration_s"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "endpoint": {
      "type": "object",
      "required": [
        "board_id",
        "node"
      ],
      "properties": {
        "board_id": {
          "$ref": "#/$defs/id"
        },
        "node": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "power_w": {
          "type": "number",
          "minimum": 0
        },
        "ambient_resistance_c_per_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thermal_capacitance_j_per_c": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initial_temperature_c": {
          "type": "number",
          "minimum": -273.15
        }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": [
        "from_id",
        "to_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from_id": {
          "$ref": "#/$defs/id"
        },
        "to_id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "resistance_c_per_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conductance_w_per_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conductivity_w_mk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thermal_conductivity_w_mk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contact_area_mm2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
