{
  "contract": "spike/python-workspace-api/v1",
  "members": [
    {"path": "spike", "kind": "module", "signature": "import spike", "description": "Bound SPIKE workspace API for the current run or debug session."},
    {"path": "spike.design", "kind": "property", "signature": "spike.design", "description": "Selected normalized board design, or None."},
    {"path": "spike.results", "kind": "property", "signature": "spike.results", "description": "Legacy current results context, or None."},
    {"path": "spike.boards", "kind": "namespace", "signature": "spike.boards", "description": "Occurrence-scoped board inventory."},
    {"path": "spike.boards.list", "kind": "function", "signature": "spike.boards.list()", "description": "List board occurrence summaries without merging equal names.", "insert_text": "boards.list()"},
    {"path": "spike.boards.get", "kind": "function", "signature": "spike.boards.get(board_id=None, *, name=None)", "description": "Get one board occurrence by ID, selected board by default, or an unambiguous name.", "insert_text": "boards.get(${1:board_id})"},
    {"path": "spike.nets", "kind": "namespace", "signature": "spike.nets", "description": "Board-scoped normalized net inventory."},
    {"path": "spike.nets.list", "kind": "function", "signature": "spike.nets.list(board_id=None)", "description": "List nets on one occurrence-scoped board.", "insert_text": "nets.list(${1:board_id})"},
    {"path": "spike.nets.get", "kind": "function", "signature": "spike.nets.get(net_id=None, *, name=None, board_id=None)", "description": "Get one board-scoped net by canonical ID or unambiguous name.", "insert_text": "nets.get(${1:net_id}, board_id=${2:board_id})"},
    {"path": "spike.layers", "kind": "namespace", "signature": "spike.layers", "description": "Board-scoped physical layer inventory."},
    {"path": "spike.layers.list", "kind": "function", "signature": "spike.layers.list(board_id=None)", "description": "List layers on one occurrence-scoped board.", "insert_text": "layers.list(${1:board_id})"},
    {"path": "spike.layers.get", "kind": "function", "signature": "spike.layers.get(layer_id=None, *, name=None, board_id=None)", "description": "Get one layer by canonical ID or unambiguous name.", "insert_text": "layers.get(${1:layer_id}, board_id=${2:board_id})"},
    {"path": "spike.components", "kind": "namespace", "signature": "spike.components", "description": "Board-scoped component inventory."},
    {"path": "spike.components.list", "kind": "function", "signature": "spike.components.list(board_id=None)", "description": "List components on one occurrence-scoped board.", "insert_text": "components.list(${1:board_id})"},
    {"path": "spike.components.get", "kind": "function", "signature": "spike.components.get(component_id=None, *, reference=None, board_id=None)", "description": "Get one component by canonical ID or unambiguous reference.", "insert_text": "components.get(${1:component_id}, board_id=${2:board_id})"},
    {"path": "spike.assembly", "kind": "namespace", "signature": "spike.assembly", "description": "Explicit assembly data from the workspace snapshot."},
    {"path": "spike.assembly.connector_links", "kind": "function", "signature": "spike.assembly.connector_links()", "description": "List explicit connector link mappings; shared names never imply a link.", "insert_text": "assembly.connector_links()"},
    {"path": "spike.analysis", "kind": "namespace", "signature": "spike.analysis", "description": "Registered worker catalog and admitted operation access."},
    {"path": "spike.analysis.catalog", "kind": "function", "signature": "spike.analysis.catalog()", "description": "Read current worker capabilities and registered solver catalog.", "insert_text": "analysis.catalog()"},
    {"path": "spike.analysis.run", "kind": "function", "signature": "spike.analysis.run(method, params=None)", "description": "Call a registered worker method through its ordinary validation.", "insert_text": "analysis.run(${1:method}, ${2:params})"},
    {"path": "spike.result_data", "kind": "namespace", "signature": "spike.result_data", "description": "Current result context access without replacing legacy spike.results."},
    {"path": "spike.result_data.current", "kind": "property", "signature": "spike.result_data.current", "description": "Detached current results context, or None."},
    {"path": "spike.result_data.get", "kind": "function", "signature": "spike.result_data.get()", "description": "Return a detached current results context, or None.", "insert_text": "result_data.get()"},
    {"path": "spike.ui", "kind": "namespace", "signature": "spike.ui", "description": "Bounded declarative UI action requests returned to the host."},
    {"path": "spike.ui.select_net", "kind": "function", "signature": "spike.ui.select_net(board_id, net_id)", "description": "Request selection of an existing net on an occurrence-scoped board.", "insert_text": "ui.select_net(${1:board_id}, ${2:net_id})"},
    {"path": "spike.ui.focus_board", "kind": "function", "signature": "spike.ui.focus_board(board_id)", "description": "Request focus of an existing board occurrence.", "insert_text": "ui.focus_board(${1:board_id})"},
    {"path": "spike.ui.open_panel", "kind": "function", "signature": "spike.ui.open_panel(panel)", "description": "Request one allowed panel: layers, nets, connector_links, results, or issues.", "insert_text": "ui.open_panel(${1:panel})"},
    {"path": "spike.call", "kind": "function", "signature": "spike.call(method, params=None)", "description": "Call a registered worker method through normal validation.", "insert_text": "call(${1:method}, ${2:params})"},
    {"path": "spike.extensions", "kind": "function", "signature": "spike.extensions()", "description": "Inspect installed extensions, contributions, permissions, and trust.", "insert_text": "extensions()"},
    {"path": "spike.invoke_extension", "kind": "function", "signature": "spike.invoke_extension(extension_id, contribution_id, parameters=None)", "description": "Invoke a session-trusted extension contribution with declared context.", "insert_text": "invoke_extension(${1:extension_id}, ${2:contribution_id}, ${3:parameters})"},
    {"path": "spike.publish_scalar_field", "kind": "function", "signature": "spike.publish_scalar_field(name, samples, *, mode='dc', solver='python-script', model_status='unvalidated', summary=None)", "description": "Offer one finite design-bound scalar field for host admission.", "insert_text": "publish_scalar_field(${1:name}, ${2:samples})"},
    {"path": "spike.publish_result", "kind": "function", "signature": "spike.publish_result(result)", "description": "Offer one complete design-bound AnalysisResult for host admission.", "insert_text": "publish_result(${1:result})"}
  ]
}
